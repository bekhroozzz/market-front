# Public backend URL used by the browser and as the SSR fallback.
NUXT_PUBLIC_BASE_API_URL=https://api.locafun.uz

# Optional: internal API URL used ONLY for server-side (SSR) requests, to skip
# the public TLS + reverse-proxy round-trip. Requires the frontend and API to
# share a Docker network in Dokploy. Leave empty to always use the public URL.
# Example (Dokploy internal service hostname + container port):
# NUXT_API_INTERNAL_URL=http://market-api:4000

# Number of PM2 SSR cluster workers (default 2). Raise together with the
# container memory limit in Dokploy.
PM2_INSTANCES=2
